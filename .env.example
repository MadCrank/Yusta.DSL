# ──────────────────────────────────────────────
# Yusta Dify Dev Environment — Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Dify Version ────────────────────────────
# Use "latest" for the newest release, or pin a specific version:
#   langgenius/dify-api:1.13.3 →  DIFY_VERSION=1.13.3
#   langgenius/dify-api:latest  →  DIFY_VERSION=latest
DIFY_VERSION=latest
# Plugin daemon has its own versioning (separate from Dify API).
# Compatible versions: 0.5.3-local, 0.6.3-local
# DIFY_PLUGIN_VERSION=0.6.3-local

# ── Admin Account (created on first startup) ──
ADMIN_EMAIL=admin@yusta.local
ADMIN_PASSWORD=yusta-admin-123
# INIT_PASSWORD sets the initial admin password for Dify's built-in setup.
# Leave empty to use the Dify web setup wizard on first visit.
INIT_PASSWORD=

# ── Database ────────────────────────────────
DB_USERNAME=dify
DB_PASSWORD=difyai123456
DB_DATABASE=dify
DB_HOST=db
DB_PORT=5432

# ── Redis ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456

# ── Deployment URLs ─────────────────────────
# Defaults work for local docker compose.
# Change only if you need custom ports / hosts.
CONSOLE_API_URL=http://localhost:5001
CONSOLE_WEB_URL=http://localhost:3000
SERVICE_API_URL=http://localhost:5001
APP_API_URL=http://localhost:5001
APP_WEB_URL=http://localhost:3000
TRIGGER_URL=http://api:5001
FILES_URL=http://localhost:5001

# ── Web UI Port ─────────────────────────────
WEB_PORT=3000

# ── AI Model Provider (OpenAI-compatible) ───
# Required. The DSL workflows use the openai_api_compatible provider.
# Point these to your LLM endpoint (OpenAI, vLLM, Ollama, LiteLLM, etc.)
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── Model Name Mapping ──────────────────────
# DSL files reference model names like "pro", "pro-2026-03-01", "lite".
# These are replaced at import time with the actual model names available
# in your configured provider. Adjust to match your LLM endpoint.
DIFY_MODEL_PRO=gpt-4o
DIFY_MODEL_LITE=gpt-4o-mini

# ── Security ────────────────────────────────
# Secret key for JWT signing and session encryption.
# Generate a new one for production use.
SECRET_KEY=your-secret-key-here
# Plugin daemon internal auth key. Must match between api and plugin_daemon.
# PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
# Plugin daemon database name
# DB_PLUGIN_DATABASE=dify_plugin

# ── Storage ─────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage
